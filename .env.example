# Copy to .env for local development: cp .env.example .env
# .env is git-ignored — never commit real credentials.

# Local PostgreSQL — used by BOTH docker-compose (the container) and the app
# (the datasource). Defaults below are local-dev only, not secrets. docker-compose
# auto-loads this .env; for the app, export these or rely on the same defaults.
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore

# JWT signing secret (HS256 needs >= 32 bytes) and token lifetime in ms.
# In real deployments this MUST be set to a strong, secret value.
JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789abcdef
JWT_EXPIRATION_MS=3600000
